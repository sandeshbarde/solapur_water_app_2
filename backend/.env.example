# Backend Configuration
FLASK_ENV=development
FLASK_APP=server.py
SECRET_KEY=replace_with_a_secure_jwt_secret_key_32chars
DATABASE_URL=sqlite:///solapur_water.db

# Admin Seeding Password (Used by seed.py)
ADMIN_DEFAULT_PASSWORD=replace_with_secure_admin_password

# AI Assistant Integration (Gemini / Claude / OpenAI API Key)
AI_API_KEY=your_ai_api_key_here

# Stadia / MapTiler API Key (Optional fallback tile provider)
# NOTE: If you previously used a hardcoded key in local.env, please rotate it immediately.
MAP_API_KEY=your_map_api_key_here

# Device Token for IoT Sensor Gateway authentication
IOT_GATEWAY_TOKEN=solapur_iot_gateway_secure_token_9912
